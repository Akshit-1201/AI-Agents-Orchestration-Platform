# ============================================================================
# Yuno AI Agents Orchestration Platform — root .gitignore
# Committed on purpose: source, docs (CLAUDE.md, DATABASES.md, plan.md, README),
# architecture diagrams, Alembic migrations, and .claude/skills/.
# Ignored below: generated artifacts, local env, secrets, caches.
# ============================================================================

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.egg-info/
.eggs/
build/
dist/

# --- Virtual environments ---
.venv/
venv/
env/
ENV/

# --- Environment / secrets (keep the example template) ---
.env
.env.*
!.env.example

# --- Databases (local SQLite) ---
*.db
*.sqlite
*.sqlite3
*.db-journal

# --- RAG vector store (Chroma, generated by ingestion) ---
.chroma/
**/.chroma/

# --- Test / type / lint caches ---
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
coverage.xml

# --- Frontend (Phase 4: Next.js) ---
node_modules/
.next/
out/
.turbo/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# --- Claude Code (keep skills + shared settings; ignore local overrides) ---
.claude/settings.local.json

# --- Editors / IDEs ---
.idea/
.vscode/
*.swp
*.swo

# --- OS cruft ---
.DS_Store
Thumbs.db
desktop.ini

# --- Logs / temp ---
*.log
tmp/
*.tmp
