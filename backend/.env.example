# Copy to .env and adjust as needed. All values have working defaults; the API
# runs without any of these, and the test suite runs fully offline (USE_FAKE_LLM).

# Async SQLAlchemy database URL (path is relative to where uvicorn is launched).
DATABASE_URL=sqlite+aiosqlite:///./yuno.db

# --- LLM provider: OpenAI (cloud, picked by an agent's model name) -> Ollama local fallback ---
# Any agent whose model starts with gpt-*/o* runs on OpenAI. Tested models:
#   gpt-4.1-nano, gpt-5-nano, gpt-4o-mini, gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini      # used when an agent's model field is left blank
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5
# Local Ollama setup for the fallback + RAG embeddings:
#   ollama pull qwen2.5 nomic-embed-text
# Optional: price any model from here (USD per 1M tokens, [input, output]); overrides the
# built-in table so the cost column stays correct without code changes:
#   OPENAI_PRICE_OVERRIDES={"gpt-4.1-mini": [0.40, 1.60], "gpt-5-nano": [0.05, 0.40]}

# --- Embeddings (RAG): OpenAI (if key) -> Ollama ---
EMBEDDING_MODEL_OPENAI=text-embedding-3-small
EMBEDDING_MODEL_OLLAMA=nomic-embed-text

# --- RAG vector store ---
VECTOR_STORE_DIR=./.chroma
RAG_TOP_K=4

# --- Runtime ---
# USE_FAKE_LLM=true uses a deterministic offline model (tests set this automatically)
USE_FAKE_LLM=false
DEFAULT_MAX_STEPS=12

# --- External channels (Phase 5) ---
# Telegram bot token from @BotFather. When set, a polling bot starts with the API.
TELEGRAM_TOKEN=
# Optional: comma-separated Telegram chat ids allowed to trigger runs (empty = allow all).
TELEGRAM_ALLOWED_CHAT_IDS=
